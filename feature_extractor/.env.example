# Azure Blob Storage — leave unset to use local filesystem fallback
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=app-assets

# Local blob fallback path (used when AZURE_STORAGE_CONNECTION_STRING is unset)
LOCAL_BLOB_DIR=./data/blobs

# LLM
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5.4-mini

# PostgreSQL connection string
DATABASE_URL=postgresql://fcadmin:local_dev_password@localhost:5432/federal_center_sw

# OpenAI embedding model
EMBEDDING_MODEL=text-embedding-3-small
