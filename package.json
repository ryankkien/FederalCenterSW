{
  "name": "federal-center-sw",
  "private": true,
  "version": "0.1.0",
  "description": "TypeScript frontend and Python backend workspace.",
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,green \"bun run dev:frontend\" \"bun run dev:backend\"",
    "dev:frontend": "bun run --cwd frontend dev",
    "dev:backend": ".venv/bin/python -m uvicorn app.main:app --app-dir backend --reload",
    "local:up": "./scripts/local-up.sh",
    "local:down": "./scripts/local-down.sh",
    "local:reset": "./scripts/local-reset.sh",
    "db:upgrade": "PYTHONPATH=backend .venv/bin/alembic -c backend/alembic.ini upgrade head",
    "fixtures:seed": "PYTHONPATH=backend .venv/bin/python -m app.fixtures",
    "processing:run": "PYTHONPATH=backend .venv/bin/python -m app.processing_cli",
    "data:backfill-primitives": "PYTHONPATH=backend .venv/bin/python -m app.primitive_backfill_cli",
    "knowledge:ingest": "PYTHONPATH=backend .venv/bin/python -m app.knowledge_cli ingest",
    "knowledge:build": "PYTHONPATH=backend .venv/bin/python -m app.knowledge_cli build",
    "corpus:build-synthetic": "PYTHONPATH=backend .venv/bin/python -m app.synthetic_corpus",
    "email:intake": "PYTHONPATH=backend .venv/bin/python -m app.email_intake",
    "infra:whatif": "./scripts/infra-whatif.sh",
    "infra:deploy": "./scripts/infra-deploy.sh",
    "build": "bun run --cwd frontend build",
    "lint": "bun run --cwd frontend lint",
    "test": "bun run --cwd frontend test && .venv/bin/python -m pytest backend/tests"
  },
  "workspaces": [
    "frontend"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
