# Local-only development mirror. Copy to backend/.env.local or backend/.env.

# Local PostgreSQL container from compose.yaml
DATABASE_URL=postgresql+psycopg://fcadmin:local_dev_password@127.0.0.1:5432/federal_center_sw

# Auth
AUTH_MODE=mock
AUTH_SECRET_KEY=dev-only-auth-secret-change-me
INTERNAL_SERVICE_TOKEN=local-dev-internal-token
ENTRA_TENANT_ID=
AZURE_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=
ENTRA_ISSUER=
ENTRA_JWKS_URL=
ENTRA_JWKS_JSON=
ENTRA_OFFICIAL_GROUP_IDS=
ENTRA_CONTRACTOR_GROUP_IDS=

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=devstoreaccount1
AZURE_STORAGE_CONTAINER=app-assets
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
LOCAL_BLOB_DIR=backend/data/blobs

# Observability
APPINSIGHTS_CONNECTION_STRING=
APPLICATIONINSIGHTS_CONNECTION_STRING=
LOG_LEVEL=INFO

# Email intake worker
EMAIL_INTAKE_HOST=localhost
EMAIL_INTAKE_PORT=993
EMAIL_INTAKE_USERNAME=local@example.com
EMAIL_INTAKE_PASSWORD=local-dev-password
EMAIL_INTAKE_MAILBOX=INBOX
EMAIL_INTAKE_SEARCH=UNSEEN
EMAIL_INTAKE_PROCESSED_MAILBOX=Processed
EMAIL_INTAKE_FAILED_MAILBOX=Failed
EMAIL_INTAKE_DRY_RUN=true
EMAIL_INTAKE_OUTPUT_PATH=backend/data/email_intake.local.jsonl
EMAIL_INTAKE_DEFAULT_UPLOADER_ID=contractor-demo
EMAIL_INTAKE_DEFAULT_DOCUMENT_TYPE=Email Attachment
EMAIL_INTAKE_TIMER_SCHEDULE=0 */5 * * * *
EMAIL_INTAKE_LIMIT=25
EMAIL_INTAKE_STUB_BLOB_ENABLED=true
EMAIL_INTAKE_STUB_BLOB_CONNECTION_STRING=
EMAIL_INTAKE_STUB_BLOB_CONTAINER=app-assets
EMAIL_INTAKE_STUB_BLOB_PREFIX=email-intake-local
EMAIL_INTAKE_AUTO_REPLY_ENABLED=false
RESEND_API_KEY=
EMAIL_INTAKE_AUTO_REPLY_FROM=local@example.com
EMAIL_INTAKE_AUTO_REPLY_SUBJECT=Your email has been received
EMAIL_INTAKE_AUTO_REPLY_BODY=Your email has been received. Thank you.

# Document processing worker
DOCUMENT_PROCESSING_TIMER_SCHEDULE=0 */5 * * * *
DOCUMENT_PROCESSING_LIMIT=25

# Document OCR. Requires `brew install tesseract` for scanned PDFs.
DOCUMENT_OCR_TESSERACT_CMD=tesseract
DOCUMENT_OCR_LANGUAGE=eng
DOCUMENT_OCR_MAX_PAGES=25
DOCUMENT_OCR_DPI_SCALE=2.0

# AI processing. Keep real keys out of git.
AI_PROVIDER=openai
AI_PROCESSING_ENABLED=false
AI_INLINE_PROCESSING_ENABLED=false
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_LLM_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3
FEATURE_EXTRACTOR_URL=http://127.0.0.1:8001
FEATURE_EXTRACTOR_REQUEST_TIMEOUT_SECONDS=120
BACKEND_API_URL=http://localhost:8000
ANTHROPIC_API_KEY=
MODEL_PREFERENCE=claude
EMBEDDING_MODEL=text-embedding-3-small

# Optional official-source knowledge ingestion. Leave blank unless authorized.
SAM_API_KEY=
REGULATIONS_API_KEY=
CPARS_IMPORT_DIR=
