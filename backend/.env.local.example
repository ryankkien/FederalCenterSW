# Local-only development mirror. Copy to backend/.env.local or backend/.env.

# Local PostgreSQL container from compose.yaml
DATABASE_URL=postgresql+psycopg://fcadmin:local_dev_password@127.0.0.1:5432/federal_center_sw

# Local Azurite container from compose.yaml
AZURE_STORAGE_ACCOUNT=devstoreaccount1
AZURE_STORAGE_CONTAINER=app-assets
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFeqCnf2mqk3aE7GcxY8wEkxSQ9fL3aPo/l72tK4G8Y7YX8WfPjY4I3K0W2d8t0oL8+/hQ==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# Local email intake defaults. These keep the worker safe by default.
EMAIL_INTAKE_HOST=localhost
EMAIL_INTAKE_PORT=993
EMAIL_INTAKE_USERNAME=local@example.com
EMAIL_INTAKE_PASSWORD=local-dev-password
EMAIL_INTAKE_MAILBOX=INBOX
EMAIL_INTAKE_SEARCH=UNSEEN
EMAIL_INTAKE_PROCESSED_MAILBOX=Processed
EMAIL_INTAKE_FAILED_MAILBOX=Failed
EMAIL_INTAKE_DRY_RUN=true
EMAIL_INTAKE_OUTPUT_PATH=backend/data/email_intake.local.jsonl

# Use Azurite for durable local blob stub testing.
EMAIL_INTAKE_STUB_BLOB_ENABLED=true
EMAIL_INTAKE_STUB_BLOB_CONTAINER=app-assets
EMAIL_INTAKE_STUB_BLOB_PREFIX=email-intake-local

# Local document OCR. Requires `brew install tesseract`.
DOCUMENT_OCR_TESSERACT_CMD=tesseract
DOCUMENT_OCR_LANGUAGE=eng
DOCUMENT_OCR_MAX_PAGES=25
DOCUMENT_OCR_DPI_SCALE=2.0

# Keep auto-replies disabled locally. Set RESEND_API_KEY in an ignored env file
# only if you want to test live Resend sends from local.
EMAIL_INTAKE_AUTO_REPLY_ENABLED=false
RESEND_API_KEY=
EMAIL_INTAKE_AUTO_REPLY_FROM=local@example.com
EMAIL_INTAKE_AUTO_REPLY_SUBJECT=Your email has been received
EMAIL_INTAKE_AUTO_REPLY_BODY=Your email has been received. Thank you.
