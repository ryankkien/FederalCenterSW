# Azure PostgreSQL
DATABASE_URL=postgresql+psycopg://<user>:<password>@federal-center-sw-dev-pg-jal50w.postgres.database.azure.com:5432/federal_center_sw?sslmode=require

# Auth
AUTH_SECRET_KEY=<replace-with-a-long-random-secret>

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=fcswdevcwm2xrlu
AZURE_STORAGE_CONTAINER=app-assets
AZURE_STORAGE_CONNECTION_STRING=<connection-string>

# Email intake worker
EMAIL_INTAKE_HOST=imap.example.com
EMAIL_INTAKE_PORT=993
EMAIL_INTAKE_USERNAME=<email-username>
EMAIL_INTAKE_PASSWORD=<email-password-or-app-password>
EMAIL_INTAKE_MAILBOX=INBOX
EMAIL_INTAKE_SEARCH=UNSEEN
EMAIL_INTAKE_PROCESSED_MAILBOX=Processed
EMAIL_INTAKE_FAILED_MAILBOX=Failed
EMAIL_INTAKE_DRY_RUN=true
EMAIL_INTAKE_OUTPUT_PATH=backend/data/email_intake.jsonl
EMAIL_INTAKE_DEFAULT_UPLOADER_ID=contractor-demo
EMAIL_INTAKE_DEFAULT_DOCUMENT_TYPE=Email Attachment

# Email intake auto reply (sends via Resend)
EMAIL_INTAKE_AUTO_REPLY_ENABLED=false
RESEND_API_KEY=<resend-api-key>
EMAIL_INTAKE_AUTO_REPLY_FROM=<verified-sender-on-resend-domain>
EMAIL_INTAKE_AUTO_REPLY_SUBJECT=Your email has been received
EMAIL_INTAKE_AUTO_REPLY_BODY=Your email has been received. Thank you.

# Discord HTML renderer
DISCORD_HTML_RENDERER_BOT_TOKEN=<discord-bot-token>
DISCORD_HTML_RENDERER_WEBHOOK_URL=<discord-channel-webhook-url>
DISCORD_HTML_RENDERER_CHANNEL_ID=<optional-channel-id>
DISCORD_HTML_RENDERER_MAX_CHARS=12000
DISCORD_HTML_RENDERER_MAX_SNIPPETS=3
DISCORD_HTML_RENDERER_VIEWPORT_WIDTH=1200
DISCORD_HTML_RENDERER_VIEWPORT_HEIGHT=800
DISCORD_HTML_RENDERER_TIMEOUT_MS=5000
DISCORD_HTML_RENDERER_ALLOW_REMOTE_ASSETS=false
