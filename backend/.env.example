# Azure PostgreSQL
DATABASE_URL=postgresql+psycopg://<user>:<password>@federal-center-sw-dev-pg-jal50w.postgres.database.azure.com:5432/federal_center_sw?sslmode=require

# Auth
AUTH_MODE=entra
AUTH_SECRET_KEY=<replace-with-a-long-random-secret>
ENTRA_TENANT_ID=<tenant-id>
AZURE_TENANT_ID=
ENTRA_CLIENT_ID=<api-client-id>
ENTRA_AUDIENCE=<api-client-id-or-app-id-uri>
ENTRA_ISSUER=
ENTRA_JWKS_URL=
ENTRA_JWKS_JSON=
ENTRA_OFFICIAL_GROUP_IDS=<comma-separated-official-group-ids>
ENTRA_CONTRACTOR_GROUP_IDS=<comma-separated-contractor-group-ids>

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=fcswdevcwm2xrlu
AZURE_STORAGE_CONTAINER=app-assets
AZURE_STORAGE_CONNECTION_STRING=<connection-string>
LOCAL_BLOB_DIR=backend/data/blobs

# Email intake worker
EMAIL_INTAKE_HOST=imap.example.com
EMAIL_INTAKE_PORT=993
EMAIL_INTAKE_USERNAME=<email-username>
EMAIL_INTAKE_PASSWORD=<email-password-or-app-password>
EMAIL_INTAKE_MAILBOX=INBOX
EMAIL_INTAKE_SEARCH=UNSEEN
EMAIL_INTAKE_PROCESSED_MAILBOX=Processed
EMAIL_INTAKE_FAILED_MAILBOX=Failed
EMAIL_INTAKE_DRY_RUN=true
EMAIL_INTAKE_OUTPUT_PATH=backend/data/email_intake.jsonl
EMAIL_INTAKE_DEFAULT_UPLOADER_ID=contractor-demo
EMAIL_INTAKE_DEFAULT_DOCUMENT_TYPE=Email Attachment
EMAIL_INTAKE_TIMER_SCHEDULE=0 */5 * * * *
EMAIL_INTAKE_LIMIT=25
EMAIL_INTAKE_STUB_BLOB_ENABLED=false
EMAIL_INTAKE_STUB_BLOB_CONNECTION_STRING=
EMAIL_INTAKE_STUB_BLOB_CONTAINER=app-assets
EMAIL_INTAKE_STUB_BLOB_PREFIX=email-intake
EMAIL_INTAKE_AUTO_REPLY_ENABLED=false
RESEND_API_KEY=<resend-api-key>
EMAIL_INTAKE_AUTO_REPLY_FROM=<verified-sender-on-resend-domain>
EMAIL_INTAKE_AUTO_REPLY_SUBJECT=Your email has been received
EMAIL_INTAKE_AUTO_REPLY_BODY=Your email has been received. Thank you.

# Document OCR
DOCUMENT_OCR_TESSERACT_CMD=tesseract
DOCUMENT_OCR_LANGUAGE=eng
DOCUMENT_OCR_MAX_PAGES=25
DOCUMENT_OCR_DPI_SCALE=2.0

# AI processing. Keep secrets in ignored local env files, Azure app settings, or Key Vault.
AI_PROVIDER=openai
AI_PROCESSING_ENABLED=false
AI_INLINE_PROCESSING_ENABLED=false
OPENAI_API_KEY=<openai-api-key>
AZURE_OPENAI_ENDPOINT=
OPENAI_LLM_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3
ANTHROPIC_API_KEY=<anthropic-api-key>
MODEL_PREFERENCE=claude
EMBEDDING_MODEL=text-embedding-3-small

# Optional official-source knowledge ingestion. Leave blank unless authorized.
SAM_API_KEY=<sam-api-key>
REGULATIONS_API_KEY=<regulations-api-key>
CPARS_IMPORT_DIR=<authorized-cpars-export-directory>
